FROM python:3.12-slim

# Optional: set DUCKDB_VERSION (see docker-compose.yml) to pin duckdb to the same
# version the pipeline uses. Empty = latest, which can read files written by
# older versions.
ARG DUCKDB_VERSION=""

RUN pip install --no-cache-dir "duckdb${DUCKDB_VERSION:+==${DUCKDB_VERSION}}" streamlit pandas

WORKDIR /app
EXPOSE 8501

# app.py is mounted from ./dashboard (see docker-compose.yml), so edits
# show up without rebuilding the image.
CMD ["streamlit", "run", "app.py", \
     "--server.address=0.0.0.0", "--server.port=8501", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]