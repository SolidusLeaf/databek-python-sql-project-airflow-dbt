FROM apache/airflow:3.2.2

USER airflow

# Folders that Docker named volumes will be mounted on. Creating them here
# (owned by the airflow user) avoids "permission denied" on first start.
RUN mkdir -p /opt/airflow/meta /opt/airflow/warehouse /opt/airflow/data/raw_json

# 1) dbt lives in its own virtualenv so it cannot clash with Airflow's
#    tightly pinned dependencies.
# 2) The duckdb version that dbt-duckdb pulled in is read back and installed
#    into Airflow's own environment, so the ingest script and dbt always open
#    the database file with the SAME duckdb version.
RUN python -m venv /home/airflow/dbt-venv \
    && /home/airflow/dbt-venv/bin/pip install --no-cache-dir dbt-duckdb \
    && DUCK_VERSION="$(/home/airflow/dbt-venv/bin/pip show duckdb | awk '/^Version:/{print $2}')" \
    && echo "Using duckdb ${DUCK_VERSION}" \
    && pip install --no-cache-dir "duckdb==${DUCK_VERSION}" requests pytest